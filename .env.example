# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Jira (set all three, or none) ---
JIRA_BASE_URL=https://99technologies.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=SHP
# Optional: custom field id holding acceptance criteria (for example customfield_10042).
JIRA_AC_FIELD=
# Release (Fix version) input. Leave false until the team confirms Fix versions are used.
JIRA_ENABLE_RELEASE=false

# --- AI ---
# "fake" returns prepared answers for local work and tests (no key needed).
# "gemini" (Google), "openai" (OpenAI) or "grok" (xAI) call a real model and need AI_API_KEY and AI_MODEL.
AI_PROVIDER=fake
AI_API_KEY=
# Model id as the provider lists it (Google AI Studio, the OpenAI models page, the xAI console).
AI_MODEL=
# Optional, comma-separated. Tried in order when the model above runs out of daily quota.
AI_FALLBACK_MODELS=
# Hard cap for the length of every AI answer.
AI_MAX_OUTPUT_TOKENS=8192

# --- GitHub (read-only token, comma-separated owner/repo list) ---
# Needed for `npm run github`, `npm run digest` and `pipeline --code-context`.
# A fine-grained token with read access to Contents and Pull requests of those repositories.
# Example: GITHUB_REPOS=99Technologies-ai/ship-nest
GITHUB_TOKEN=
GITHUB_REPOS=
# Include each ticket's pull request changes in every real run (default true).
CODE_CONTEXT=true
# You agree that source code is sent to the AI provider. Without it, a run with code context stops.
# On the free Gemini tier Google may use that content: get approval or use the paid tier first.
ALLOW_CODE_TO_AI=false

# --- API ---
# Every /api request must send this as a bearer token. Leave empty only for local use.
API_TOKEN=
# Requests one client may make to /api per minute, and runs one client may start per minute.
RATE_LIMIT_PER_MINUTE=300
GENERATE_LIMIT_PER_MINUTE=20
# Behind a proxy (so limits count real clients) and behind HTTPS (so browsers use HTTPS only).
TRUST_PROXY=false
ENABLE_HSTS=false
# Used by docker compose: the database password, and the port the page is published on.
# POSTGRES_PASSWORD=
# APP_PORT=3000
# Generation runs at the same time (the rest wait in the queue).
MAX_CONCURRENT_RUNS=1
# Read tickets from JSON files in this folder instead of Jira (offline runs and tests).
TICKET_FIXTURES_DIR=

# --- Database ---
# postgres://user:password@localhost:5432/qa_assistant  (see docker-compose.yml)
# or pglite://./.data/qa-assistant  (a database kept in a local folder, nothing to install)
# Leave empty to keep runs in a local folder (.data/qa-assistant), nothing to install.
# Use a Postgres server with: docker compose up -d, then
# DATABASE_URL=postgres://qa:qa@localhost:5432/qa_assistant
DATABASE_URL=
# Runs and cached results older than this are removed by: npm run db -- purge
DB_RETENTION_DAYS=90
