{
  "name": "qa-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Internal tool that turns Jira tickets and code changes into draft test cases and a test flow for QA review.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "pipeline": "node --env-file-if-exists=.env --import tsx src/pipeline/cli.ts",
    "eval": "node --env-file-if-exists=.env --import tsx src/ai/eval.ts",
    "knowledge": "node --env-file-if-exists=.env --import tsx src/knowledge/cli.ts",
    "github": "node --env-file-if-exists=.env --import tsx src/github/cli.ts",
    "digest": "node --env-file-if-exists=.env --import tsx src/github/digest-cli.ts",
    "export": "node --env-file-if-exists=.env --import tsx src/export/cli.ts",
    "db": "node --env-file-if-exists=.env --import tsx src/db/cli.ts",
    "ai:check": "node --env-file-if-exists=.env --import tsx src/ai/check.ts",
    "jira:check": "node --env-file-if-exists=.env --import tsx src/jira/check.ts",
    "jira:resolve": "node --env-file-if-exists=.env --import tsx src/jira/resolve-cli.ts",
    "jira:ticket": "node --env-file-if-exists=.env --import tsx src/jira/cli.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run test:e2e"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "docx": "^9.10.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jszip": "^3.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
